# SRM IST Tiruchirappalli Authentication Portal - Environment Variables Configuration

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Initial Administrator Credentials (server-side only)
ADMIN_USERNAME="ADMIN@SRM01"
ADMIN_INITIAL_PASSWORD="change-me-admin-password"

# Application Public URL (used to generate HTTPS activation and reset links)
APP_URL="http://localhost:3000"
PORT="3000"

# Real Email Delivery Configuration (Nodemailer / SMTP)
# To deliver real activation links directly to student email inboxes:
# 1. Gmail SMTP:
#    SMTP_HOST="smtp.gmail.com"
#    SMTP_PORT="465"
#    SMTP_USER="your-sender@gmail.com"
#    SMTP_PASS="your-smtp-app-password"
#    SMTP_FROM="SRM IST Admissions <admissions@ist.srmtrichy.edu.in>"
#    SMTP_SECURE="true"
#
# 2. Resend API:
#    RESEND_API_KEY=""
#    SMTP_FROM="SRM IST Admissions <onboarding@resend.dev>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-sender@gmail.com"
SMTP_PASS=""
SMTP_FROM="SRM IST Admissions <admissions@ist.srmtrichy.edu.in>"
SMTP_SECURE="true"
RESEND_API_KEY=""
